rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // A document at /admins/{UID} marks that UID as a super administrator.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /invitations/{invitationId} {
      allow get: if resource.data.status == 'published' || isOwner() || isAdmin();
      allow list: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner() || isAdmin();

      match /rsvps/{rsvpId} {
        allow create: if get(/databases/$(database)/documents/invitations/$(invitationId)).data.status == 'published'
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 128
          && request.resource.data.status in ['attending', 'declined'];
        allow read, delete: if signedIn() && (get(/databases/$(database)/documents/invitations/$(invitationId)).data.ownerUid == request.auth.uid || isAdmin());
        allow update: if false;
      }
    }

    // Admin records are created manually in the Firebase console; users cannot grant
    // themselves admin access. Admins may read the records for maintenance.
    match /admins/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
